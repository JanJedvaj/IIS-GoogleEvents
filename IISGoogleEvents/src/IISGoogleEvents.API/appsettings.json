{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtConfig": {
    "Issuer": "https://iis-google-events",
    "Audience": "https://iis-google-events",
    "AccessTokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInMinutes": 1440
  },
  "AppConfig": {
    "DataSource": "Local"
  },
  "CorsConfig": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ],
    "AllowCredentials": true
  },
  "DhmzConfig": {
    "BaseUrl": "https://vrijeme.hr/",
    "XmlPath": "hrvatska_n.xml",
    "TimeoutSeconds": 15.0
  },
  "GrpcConfig": {
    "WeatherServiceUrl": "https://localhost:7008"
  }
}
