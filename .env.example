# Template for .env. Copy it, then fill in real values:
#   cp .env.example .env
#
# Generate the secrets:
#   POSTGRES_PASSWORD  openssl rand -hex 24
#   JwtConfig__Key     openssl rand -base64 48    (HS256 needs at least 32 bytes)
#
# .env is gitignored. Never put real values in this file.
#
# Both consumers read this one file:
#   - docker compose reads it automatically (same directory as docker-compose.yml)
#   - the API loads it at startup, so "__" keys land in IConfiguration

# --- Postgres container ---
POSTGRES_DB=IISGoogleEventsDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=5433

# --- ASP.NET Core configuration overrides ("__" is the section separator) ---
ConnectionStrings__Db=Host=localhost;Port=5433;Database=IISGoogleEventsDb;Username=postgres;Password=replace-me
JwtConfig__Key=replace-me
